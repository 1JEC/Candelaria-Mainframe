# Postgres. Locally this is a Homebrew Postgres database; on Vercel this is the
# Vercel Postgres / Neon pooled connection string.
DATABASE_URL="postgresql://user@127.0.0.1:5432/candelaria_mainframe"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# 32-byte key (base64) used to encrypt integration credentials at rest.
# Generate with: openssl rand -base64 32
CREDENTIALS_KEY=""

# --- Phase 4+ (not required to run Phases 1-3) ---
# RESEND_API_KEY=""
# META_ACCESS_TOKEN=""
# GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_SEARCH_CONSOLE_KEY=""

# --- Prospecting (Leads Agent) ---
# Missing key -> the AI layer disables itself, the rest of the agent still runs.
#
# AI_PROVIDER="anthropic" -> paid per token, uses ANTHROPIC_API_KEY.
# AI_PROVIDER="openai"    -> any OpenAI-compatible endpoint (the free path).
#   AI_BASE_URL accepts a full URL or a preset: ollama | groq | openrouter | gemini | mistral
#
# Free example (Groq, no cost):
# AI_PROVIDER="openai"
# AI_BASE_URL="groq"
# AI_API_KEY=""
# MODEL_CHEAP="llama-3.1-8b-instant"
# MODEL_SMART="llama-3.3-70b-versatile"
AI_PROVIDER="anthropic"
AI_BASE_URL=""
AI_API_KEY=""
AI_TIMEOUT_MS="120000"
MODEL_CHEAP=""
MODEL_SMART=""

# Only used when AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""

# Soft daily cap in EUR, checked before every AI job. On a free backend the
# logged cost is 0.00, so the cap simply never trips.
# AI_DAILY_BUDGET_EUR="2.0"
