# Copy to .env.local and fill in actual values (NEVER commit .env.local)

# ============ DATABASE ============
DATABASE_URL="postgresql://user:password@localhost:5432/mainframe_hq"

# ============ NEXTAUTH / AUTH ============
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ============ INTEGRATIONS — API Keys (encrypted before storage in DB) ============

# Meta Graph API
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_FACEBOOK_PAGE_ID="your-page-id"
META_INSTAGRAM_BUSINESS_ACCOUNT_ID="your-ig-account-id"

# X (Twitter) API
X_API_KEY="your-x-api-key"
X_API_SECRET="your-x-api-secret"
X_BEARER_TOKEN="your-x-bearer-token"
X_ACCESS_TOKEN="your-x-access-token"
X_ACCESS_SECRET="your-x-access-secret"
X_API_TIER="free"  # free, basic, pro, enterprise

# Resend
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@candelaria-agency.com"

# ============ AI PROVIDER ============
# AI_PROVIDER="anthropic"  -> paid per token, uses ANTHROPIC_API_KEY below.
# AI_PROVIDER="openai"     -> any OpenAI-compatible endpoint. This is the free path.
#
# AI_BASE_URL accepts a full URL or one of these presets:
#   ollama     http://localhost:11434/v1   local, unlimited, no key, no cost
#   groq       free tier, rate-limited, fast
#   openrouter free tier on models whose id ends in ":free"
#   gemini     free tier via the OpenAI-compatible endpoint
#   mistral    free tier
#
# Free local example (nothing leaves the machine, no key needed):
#   AI_PROVIDER="openai"
#   AI_BASE_URL="ollama"
#   MODEL_CHEAP="qwen2.5:7b"
#   MODEL_SMART="qwen2.5:14b"
#
# Free hosted example:
#   AI_PROVIDER="openai"
#   AI_BASE_URL="groq"
#   AI_API_KEY="your-free-groq-key"
#   MODEL_CHEAP="llama-3.1-8b-instant"
#   MODEL_SMART="llama-3.3-70b-versatile"
AI_PROVIDER="anthropic"
AI_BASE_URL=""
AI_API_KEY=""
AI_TIMEOUT_MS="120000"
MODEL_CHEAP=""
MODEL_SMART=""

# Only used when AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Soft daily cap, checked before every AI job. Stays useful on free backends:
# there the logged cost is 0.00, so the cap simply never trips.
AI_DAILY_BUDGET_EUR="2.0"

# ============ FREE, NO BILLING REQUIRED ============
# PageSpeed Insights is a free Google API — a key only raises the quota to
# 25k/day. Without it the audit still runs, just without PSI scores.
PAGESPEED_API_KEY=""

# ============ PROTON MAIL WORKER ============
# These are ONLY used by the always-on worker, NOT the portal
PROTON_BRIDGE_HOST="localhost"
PROTON_BRIDGE_IMAP_PORT="1143"
PROTON_BRIDGE_SMTP_PORT="1025"
PROTON_MAIL_ADDRESS="your-proton@pm.me"
PROTON_MAIL_PASSWORD="your-bridge-password"

# Worker communicates with portal via this secure key
WORKER_API_KEY="worker-secret-api-key-change-this"
PORTAL_API_URL="https://hq.candelaria-agency.com/api"

# ============ ENCRYPTION ============
ENCRYPTION_KEY="your-aes-256-key-base64-encoded"

# ============ OPTIONAL: Google Places API (for prospecting) ============
GOOGLE_PLACES_API_KEY=""

# ============ ENVIRONMENT ============
NODE_ENV="development"
NEXT_PUBLIC_BRAND_NAME="Candelaria Agency"

# ============ VERCEL (production only) ============
# These are auto-set by Vercel dashboard, but documented here:
# VERCEL_ENV=production
# VERCEL_URL=hq.candelaria-agency.com
